# RUN: llc -mtriple=x86_64-- --yk-stackmap-add-locs %s -o - | FileCheck %s

# Check that when a register is reloaded from a stack slot with a zero-extending
# load, the slot is recorded as an additional location of that register.

# CHECK-LABEL: __LLVM_StackMaps:
# Stackmap ID 1.
# CHECK-LABEL: .quad 1
# The live value is in DWARF register 5 (`%edi`).
# CHECK: .short 5
# CHECK-NEXT: .short 0
# Number of additional locations.
# CHECK-NEXT: .short 1
# The additional location: RBP offset -16, the spill slot.
# CHECK-NEXT: .short -16
# CHECK-NEXT: .long 0
---
name: main
tracksRegLiveness: true
frameInfo:
  hasStackMap:     true
  stackSize:       16
stack:
  - { id: 0, type: spill-slot, offset: -16, size: 2, alignment: 2 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi
    $rbp = frame-setup MOV64rr $rsp
    MOV16mr $rbp, 1, $noreg, -16, $noreg, $di :: (store (s16) into %stack.0)
    CMP32ri $edi, 7, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2
    $edi = MOVZX32rm16 $rbp, 1, $noreg, -16, $noreg :: (load (s16) from %stack.0)
    JMP_1 %bb.2

  bb.2:
    liveins: $edi
    STACKMAP 1, 0, $edi, 3
    $eax = MOV32rr $edi
    RET64 $eax
